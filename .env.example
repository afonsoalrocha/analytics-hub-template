# Copy to .env and fill the systems you actually use.
# .env is gitignored. The worked example needs none of the remote variables.

# Local warehouse. make demo sets DUCKDB_PATH for you.
DUCKDB_PATH=data/warehouse.duckdb

# auto downloads the Olist sample and falls back to the synthetic seed.
# olist fails closed when the download fails. synthetic skips the network.
OLIST_SOURCE=auto

# Connectors are read-only unless this is true.
CONNECTOR_ALLOW_WRITE=false
# A dry run returns the statement and the byte ceiling without a network call.
CONNECTOR_DRY_RUN=false
# Cost ceiling in bytes. BigQuery receives it as maximumBytesBilled.
# Databricks receives it as byte_limit, the maximum bytes the API returns.
CONNECTOR_MAX_BYTES=1073741824

# MCP. .mcp.json holds no tokens. Leave the profile empty to use
# ~/.config/analytics-hub/oauth-readonly.json when that file exists.
# The profile must set read_only to true and must live outside this repository.
MCP_FILESYSTEM_ROOT=.
MCP_OAUTH_PROFILE=

# Postgres. sslmode must stay verify-full or verify-ca.
POSTGRES_HOST=postgres.example.invalid
POSTGRES_PORT=5432
POSTGRES_DB=analytics
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=verify-full
POSTGRES_CONNECT_TIMEOUT_SECONDS=10

# Databricks SQL Statement API. Host must be https.
DATABRICKS_HOST=https://workspace.example.invalid
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_TIMEOUT_SECONDS=60
DATABRICKS_MAX_POLLS=10

# BigQuery. Use a bearer token or a service-account file. Never commit the file.
BIGQUERY_PROJECT=
BIGQUERY_ACCESS_TOKEN=
BIGQUERY_TIMEOUT_SECONDS=60
BIGQUERY_MAX_POLLS=10
GOOGLE_APPLICATION_CREDENTIALS=

# GA4 Data API. Property id is numeric. The query body is JSON, not SQL.
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=
GA4_TIMEOUT_SECONDS=60

# Azure Blob. Account is the account name, not a URL. SAS token is a secret.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_SAS_TOKEN=
AZURE_TIMEOUT_SECONDS=60

# Azure DevOps. PAT is a secret. query() takes a WIQL statement.
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=
